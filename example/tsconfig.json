{
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		"declaration": true,
		"importHelpers": true,
		"inlineSources": true,
		"declarationMap": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"strictBindCallApply": true,
		"moduleResolution": "bundler",
		"target": "ES2025",
		"module": "ES2022",
		"lib": [
			"ES2025",
			"dom"
		],
		"strict": true,
		"strictPropertyInitialization": false,
		"strictBuiltinIteratorReturn": true,
		"removeComments": false
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx"
	],
	"files": [
		"src/index.ts"
	],
	"compileOnSave": true
}